# COS environment template. Copy to .env and fill in. NEVER commit real secrets.
# Grounded in spec/02-system-architecture.md §4 (stack) and spec/15-deployment-guide.md.

# ---- Database (Supabase Postgres + pgvector) ----
# Control plane connects with the anon/authenticated role (RLS enforced, doc 04 §12).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cos"
# Workers connect with the service role (bypasses RLS; confined to worker network, doc 04 §12).
DATABASE_SERVICE_URL="postgresql://postgres:postgres@localhost:5432/cos"

# ---- Supabase (auth + storage) ----
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Redis (BullMQ queues + pub/sub for realtime) ----
REDIS_URL="redis://localhost:6379"

# ---- Model access (doc 02 §4; doc 09 model tiers) ----
# Provider selection: 'mock' (default, keyless) or 'openrouter'. Embedder: 'mock' or 'openai'.
COS_MODEL_PROVIDER="mock"
COS_EMBEDDER="mock"
COS_OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"   # default model when route is unset
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""              # embeddings (text-embedding-3-small, 1536 dims, doc 04 §1.1)

# ---- Research tools (MCP, doc 08) ----
FIRECRAWL_API_KEY=""
EXA_API_KEY=""

# ---- Design (Canva Connect API, doc 08 §5.1) ----
CANVA_ACCESS_TOKEN=""
CANVA_BRAND_TEMPLATE_ID=""     # optional: autofill copy into a Zentrix brand template

# ---- Publishing / analytics (Instagram Graph API, doc 08 §4) ----
INSTAGRAM_GRAPH_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
INSTAGRAM_GRAPH_API_VERSION="v21.0"

# ---- Product analytics ----
POSTHOG_KEY=""
POSTHOG_HOST="https://us.posthog.com"

# ---- Runtime ----
NODE_ENV="development"
COS_ENV="local"               # local | staging | production (doc 02 §9)
DAILY_BUDGET_USD="25"         # seeds system_settings 'budget.daily_usd' (doc 04 §4.2)
